# Optional. Defaults to /gateway-api through the Vite/nginx proxy.
VITE_GATEWAY_API_BASE=/gateway-api
VITE_CIAM_TENANT_ID=meridian
VITE_CIAM_CUSTOMER_CLIENT_ID=ciam-card-customer-spa
VITE_CIAM_CUSTOMER_SCOPES=cards:incident.read

# Browser storage keys used by the admin UI.
