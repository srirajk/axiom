# Meridian reference deployment. Copy to .env before starting Compose.
AXIOM_TENANT_ID=meridian
AXIOM_TENANT_NAME=Meridian
AXIOM_TENANT_SLUG=meridian

AXIOM_DB_PASSWORD=meridian-axiom-db-dev-change-me
AXIOM_ADMIN_PASSWORD=meridian-axiom-admin-dev-change-me
AXIOM_SECRETS_MASTER_KEY=<base64-encoded-32-byte-local-key>
IAM_FEDERATION_METADATA_ALLOWED_HOSTS=

# Optional Policy Studio authoring assistant. Axiom remains fully operational
# without these values: it falls back to a deterministic proposal, and Cerbos,
# validation, consequence review, SoD approval and promotion remain authoritative.
ZAI_API_KEY=
IAM_POLICY_STUDIO_MODEL=glm-4.6
IAM_POLICY_STUDIO_BASE_URL=https://api.z.ai/api/paas/v4
IAM_POLICY_STUDIO_PROSE_MODEL=glm-4.6
IAM_POLICY_STUDIO_PROSE_BASE_URL=https://api.z.ai/api/paas/v4

# Explicit local host endpoints. Change these when another stack already uses a port.
AXIOM_HTTP_HOST_PORT=8180
AXIOM_ADMIN_HOST_PORT=5182
AXIOM_CONSUMER_BROWSER_ORIGINS=http://localhost:5173
AXIOM_POSTGRES_HOST_PORT=5434
AXIOM_REDIS_HOST_PORT=6381
AXIOM_CERBOS_HTTP_HOST_PORT=3692
AXIOM_CERBOS_GRPC_HOST_PORT=3693

AXIOM_ISSUER_URL=http://localhost:8180
AXIOM_ADMIN_REDIRECT_URI=http://localhost:5182/callback
AXIOM_ADMIN_POST_LOGOUT_REDIRECT_URI=http://localhost:5182/login
AXIOM_LOCAL_DEMO_BROWSER_CLIENT_ID=probata-spa
AXIOM_LOCAL_DEMO_BROWSER_TOKEN_TTL_SECONDS=28800
